class Solution {
public:
    int maxSubarraySum(vector<int>& arr, int k) {
        int n = arr.size();
        int currSum = 0; 
        for(int i = 0; i< k ; i++){
            currSum += arr[i];
        }
        int maxSum = currSum;
        for(int i = k ; i < n ; i++){
            currSum += arr[i];
            currSum -= arr[i - k];
            maxSum = max(maxSum , currSum);
        }
        return maxSum; 
    }
};
