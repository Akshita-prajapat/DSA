class Solution {
public:
    int findKthNumber(int m, int n, int k) {
        int low =1;
        int high = n * m;
        int ans =1;
        while(low <= high){
            int mid = (low + high)/2;
            long long count = 0;
            for(int i =1; i<=m ; i++){
                count += min(n , mid/i);
            }
            if(count >= k){
                ans  =mid;
                high = mid -1;
            }else low = mid +1;
        }
        return ans;
    }
};
